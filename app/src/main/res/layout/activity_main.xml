<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_default"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- A ScrollView keeps every element accessible on smaller phones. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/screen_title"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/screen_subtitle"
                android:textColor="@color/white_soft"
                android:textSize="15sp" />

            <!-- The card contains the content that changes after each button tap. -->
            <LinearLayout
                android:id="@+id/motivation_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/card_background"
                android:elevation="8dp"
                android:gravity="center"
                android:minHeight="245dp"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/emoji_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/emoji_welcome_description"
                    android:gravity="center"
                    android:text="@string/emoji_welcome"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/message_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/welcome_message"
                    android:textColor="@color/ink"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- This is intentionally the only button in the application. -->
            <Button
                android:id="@+id/inspire_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/button_background"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.03"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="@string/inspire_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tap_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/tap_count_zero"
                android:textColor="@color/white_soft"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="@string/created_by"
                android:textColor="@color/white_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
